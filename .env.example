APP_NAME=BakiMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use the same host:port the Expo app calls (see EXPO_PUBLIC_API_URL in bakimate/.env).
# `php artisan serve` → http://127.0.0.1:8000 — from a phone, use --host=0.0.0.0 and your LAN IP.
APP_URL=http://127.0.0.1:8000

# Filament staff panel — require TOTP app MFA after login (set once DB + Shield are set up).
# FILAMENT_ADMIN_MFA_REQUIRED=true

# Optional: restrict /admin to these IPs (comma-separated IPv4/IPv6). Empty = no IP filter.
# ADMIN_PANEL_ALLOWED_IPS=203.0.113.10,192.168.1.50

# -----------------------------------------------------------------------------
# Production (Railway) — Service → Variables (reference MySQL from the plugin)
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://YOUR-SERVICE.up.railway.app
# APP_KEY=base64:...   # set once: php artisan key:generate --show (or Railway generates)
#
# Trust Railway’s edge proxy so HTTPS / X-Forwarded-* are correct (see bootstrap/app.php).
# TRUSTED_PROXIES=*
#
# Logs to stdout (recommended on Railway)
# LOG_CHANNEL=stderr
# LOG_LEVEL=info
#
# CORS — comma-separated list of allowed browser origins. Mobile clients don't
# send an Origin header, so this only matters for browser callers (e.g. the
# public /v/{token} balance link). Leave as `*` until you ship a web UI.
# CORS_ALLOWED_ORIGINS=https://bakimate.com,https://www.bakimate.com
#
# Sanctum cookie sessions from the Next.js site (if you use session auth from the browser):
# SANCTUM_STATEFUL_DOMAINS=bakimate.com,www.bakimate.com
#
# Public Networking "Target port" MUST match the container listen port (Railway’s
# $PORT, often 8080). If they differ, you get 502s and failed /up healthchecks.
#
# Mail (Mailgun) — set MAIL_MAILER=mailgun plus MAILGUN_* and MAIL_FROM_* below
# or duplicate the commented block under "Mail — Laravel notifications".

# Demo login — POST /api/auth/demo. If DEMO_LOGIN_ENABLED is unset: on only when APP_ENV=local.
# DEMO_LOGIN_ENABLED=false
# DEMO_LOGIN_ENABLED=true

# Google id_token audience(s): list every OAuth client whose tokens you accept (id_token claim "aud").
# Option A — one CSV list:
# GOOGLE_CLIENT_IDS=id-ios.apps.googleusercontent.com,id-android.apps.googleusercontent.com,id-web.apps.googleusercontent.com
#
# Option B — same names as Expo (bakimate/.env EXPO_PUBLIC_GOOGLE_* — copy values only, paste here without EXPO_PUBLIC_):
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_EXPO_CLIENT_ID=
# GOOGLE_CLIENT_ID=
#
# You can mix A + B; duplicates are ignored. Expo Go proxy typically uses WEB (or EXPO) client aud.
#
# Native Expo builds: Google's Web OAuth client only allows https redirect URIs — use Laravel GET /auth/google/expo-bridge
# + EXPO_PUBLIC_GOOGLE_OAUTH_HTTPS_REDIRECT in the Expo app pointing to APP_URL/auth/google/expo-bridge .
# Override app deep link if needed (usually leave default):
# GOOGLE_EXPO_OAUTH_DEEP_LINK=bakimate://oauthredirect
#
# Apple Sign in with Apple — JWT "aud" usually matches the iOS bundle ID (and/or a Services ID if you add web).
# APPLE_CLIENT_IDS=com.ihabimate.bakimate
# APPLE_CLIENT_ID=com.ihabimate.bakimate
#
# Gemini (Google AI Studio) — enables POST /api/receipt-scan for snap-to-khata — same stack as Habimate.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
#
# RevenueCat webhooks → POST /api/webhooks/subscription (App Store & Google Play / PLAY_STORE use the same RevenueCat endpoint).
# Set the same Authorization value under RevenueCat Dashboard → Integrations → Webhooks. Leave unset only for local hacks.
# REVENUECAT_WEBHOOK_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production (Railway): use the platform's stdout log driver.
# LOG_CHANNEL=stderr
# LOG_LEVEL=info

# MySQL — create the database first, then run migrations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakimate
DB_USERNAME=root
DB_PASSWORD=

# MAMP often uses MySQL on port 8889 — set DB_PORT (and DB_SOCKET if needed).
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# Railway MySQL plugin — use the reference variables Railway exposes when you
# add the MySQL plugin to the project (they auto-update on rotation):
#
# DB_CONNECTION=mysql
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Railway: API service uses railway.json (serve + migrate). Queue worker service uses
# railway.worker.json — set Config file path on that service to /railway.worker.json.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail — API email verification uses HabiMate-style Mailgun HTTP (curl) via app/Helpers/MailgunHelper.php
# (same MAILGUN_* / MAIL_FROM_* as below). Password reset still uses MAIL_MAILER (e.g. mailgun or log).
# -----------------------------------------------------------------------------
# Local: log only (no external send).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mg.your-mailgun-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Production / Railway — set these Variables on the server (never commit secrets):
#
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.example.com                     # Sending domain from Mailgun dashboard
# MAILGUN_SECRET=key-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxx  # Mailgun → Sending → Domain → API keys (private)
# MAILGUN_ENDPOINT=api.mailgun.net                  # EU domains: api.eu.mailgun.net
# MAIL_FROM_ADDRESS=noreply@mg.example.com         # Must be authorized for MAILGUN_DOMAIN
# MAIL_FROM_NAME=BakiMate
#
# Optional: MAIL_LOG_CHANNEL — only if MAIL_MAILER=log and you override the log channel

# Password reset emails use a deep link so the mobile app can open the reset screen.
# Must match Expo `scheme` in app.json (default: bakimate) and the route `reset-password`.
# PASSWORD_RESET_APP_SCHEME=bakimate
# PASSWORD_RESET_APP_PATH=reset-password

# After the user taps Verify in the email, the browser opens this URL, then the app (Expo scheme + verify-email).
# EMAIL_VERIFIED_REDIRECT_URL=bakimate://verify-email?verified=1
# EMAIL_VERIFICATION_EXPIRE_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
